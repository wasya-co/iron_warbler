
.purses-gameui {


  .Origin::before {
    content: "";
    margin-left: -1em;
    border: 1em solid transparent;
    border-top: 1em solid black;
  }
  .Origin {
    position: absolute;
    top: 0;
    left: calc( 50% );
    // z-index: -2;
  }
  .sprite {
    position: absolute;
  }
  .sprite-bottom {
    bottom: 0;
  }

  .CoordinatesW {
    // width: 500px;

    background: var(--iro-color-bg2);
    border: 1px solid red;
    margin-bottom: 3em;

    position: relative;

    z-index: 1;
  }
  .Coordinates {
    border-left: 1px solid var(--iro-color-grid1);
    border-bottom: 1px solid var(--iro-color-grid1);

    background: yellow;

    height: 100px;

    margin-left: 50%;

    position: relative;

    .Breakeven {
      // background: cyan;
      border-right: 2px solid lightblue;

      .half-circle {
        width: 100%;
        height: 100%; /* as the half of the width */
        background-color: lightblue;
        border-top-left-radius: 100%;  /* 100px of height + 10px of border */
        border-top-right-radius: 100%; /* 100px of height + 10px of border */
        // border: 10px solid gray;
        // border-bottom: 0;
      }
    }

    .Last {
      border-left: 2px dotted red;
    }
    .label {
      width: 200px;
      color: gray;
    }

    .marker {
      position: absolute;
      height: 100%;
    }

    .Net {

      position: absolute;
      bottom: 3em;
      z-index: 3;

      background: #339966;
      // border-bottom: 5px solid red;
      .label {
        color: white;
      }
    }

    .grid-mark {
      height: 100%;
      position: absolute;
      top: 0;
      width: 100px;
      z-index: 1;
      border-left: 1px dashed var(--iro-color-grid1);

      .label {
        position: absolute;
        bottom: -1em;
        z-index: 0;
      }
    }
    .mark0 {
      .label {
        bottom: -2em;
      }
    }



  }

}
