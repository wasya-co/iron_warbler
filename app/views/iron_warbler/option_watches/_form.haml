
- url = %w| new create |.include?( params[:action] ) ? option_watches_path : option_watche_path(option_watch)

= form_with model: option_watch, url: url do |f|
  - if option_watch.errors.any?
    #error_explanation
      %h2
        = pluralize(option_watch.errors.count, "error")
        prohibited this option_watch from being saved:
      %ul
        - option_watch.errors.each do |error|
          %li= error.full_message

  .field
    = f.label :ticker
    = f.text_field :ticker
  -# .field
  -#   = f.label :symbol
  -#   = f.text_field :symbol
  .field
    = f.label :contractType
    = f.text_field :contractType
  .field
    = f.label :strike
    = f.text_field :strike
  .field
    = f.label :date
    = f.text_field :date

  .actions
    = f.submit
