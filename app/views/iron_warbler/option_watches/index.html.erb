<p id="notice"><%= notice %></p>

<h1>Option Watches</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @option_watches.each do |option_watch| %>
      <tr>
        <td><%= link_to 'Show', option_watch %></td>
        <td><%= link_to 'Edit', edit_option_watch_path(option_watch) %></td>
        <td><%= link_to 'Destroy', option_watch, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Option Watch', new_option_watch_path %>
