
- strategies ||= @strategies

.strategies--table

  %table.bordered.data-table
    %thead
      %tr
        %th.actions &nbsp;
        %th stock
        %th kind
        %th long or short
        %th put_call
        %th next inner delta
        %th thresh neg delta
        %th thresh pos delta
        %th next usd above mark
        %th next inner strike
        %th next spread amount
        %th intent
        %th tgt_exposure


    %tbody
      - strategies.each do |sss|
        %tr
          %td.actions
            .d-flex
              = link_to '[~]', edit_strategy_path(sss)
              = button_to 'x', strategy_path(sss), method: :delete, data: { confirm: 'Are you sure?' }
          %td.stock= sss.stock
          %td.kind
            = sss.kind
            - if sss.descr.present?
              .descr
                = sss.descr
          %td.long-or-short= sss.long_or_short
          %td.put-call= sss.put_call
          %td= sss.next_inner_delta
          %td.threshold-neg-delta
            = sss.threshold_neg_delta
          %td.threshold-pos-delta
            = sss.threshold_pos_delta
          %td.next_usd_above_mark
            = sss.next_usd_above_mark
          %td.next_inner_strike
            = sss.next_inner_strike
          %td.next_spread_amount
            = sss.next_spread_amount
          %td.intent
            .text-nowrap= sss.intent
          %td.tgt_exposure
            = pp_amount sss.tgt_exposure


  .h-50px

