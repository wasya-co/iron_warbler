
.strategies-edit.maxwidth
  %h5.text-center.sticky
    Edit Strategy
  .row
    .col-3= render 'iro/stocks/show_card', stock: @strategy.stock
    .col-12
      - case @strategy.kind
      - when Iro::Strategy::KIND_LONG_CREDIT_PUT_SPREAD,
      -      Iro::Strategy::KIND_SHORT_CREDIT_CALL_SPREAD
        = render "form_spread", strategy: @strategy
      - else
        %b _TODO: review strategies/edit, incorporate strategies other than KIND_LONG_CREDIT_PUT_SPREAD


