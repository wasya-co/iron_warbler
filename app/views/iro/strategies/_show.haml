
%i.fa.fa-compress.collapse-expand{ id: "ce-pos-reasons-#{collapse_key}" }
  #{strategy}
.strategies--show.modal-absolute
  .header
    Strategy
    = link_to '[~]', edit_strategy_path(strategy)
    = strategy
  %ul
    -# %li <b>ticker:</b> #{strategy.ticker}
    -# %li <b>slug:</b> #{strategy.slug}

    %li <b>threshold_usd_above_mark:</b> #{strategy.threshold_usd_above_mark}
    %li <b>threshold_neg_delta:</b> #{strategy.threshold_neg_delta}
    %li <b>threshold_netp:</b> #{strategy.threshold_netp}
    %li <b>threshold_pos_delta:</b> #{strategy.threshold_pos_delta}

    %hr

    %li <b>next_inner_delta:</b> #{strategy.next_inner_delta}
    %li <b>next_inner_strike:</b> #{strategy.next_inner_strike}
    %li <b>next_spread_amount:</b> #{strategy.next_spread_amount}

  %hr
  = strategy.inspect
