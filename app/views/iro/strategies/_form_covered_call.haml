
.strategies--form
  = form_for strategy do |f|
    .actions
      = f.submit

    .row
      .col-md-6
        .field
          %label Kind:
          = strategy.kind
          = hidden_field_tag 'strategy[kind]', params[:kind]
        .field
          %label stock
          = f.select :stock_id, options_for_select(@stocks_list, selected: strategy.stock_id), class: 'select2'
        .field
          %label long or short?
          = hidden_field_tag 'strategy[long_or_short]', Iro::Strategy::LONG
          = f.select :long_or_short, options_for_select([nil, Iro::Strategy::LONG, Iro::Strategy::SHORT], selected: Iro::Strategy::LONG), {}, disabled: true
    %hr


    .field
      %label threshold_usd_above_mark
      = f.number_field :threshold_usd_above_mark, placeholder: "0.00", step: 0.01
    .field
      = f.label :threshold_dte
      = f.number_field :threshold_dte, placeholder: "1"
    .field
      = f.label :threshold_pos_delta
      = f.number_field :threshold_pos_delta, placeholder: "0.06", step: 0.001
    .field
      = f.label :threshold_neg_delta
      = f.number_field :threshold_neg_delta, placeholder: "0.6", step: 0.001

    %hr

    .field
      = f.label :next_inner_delta
      = f.number_field :next_inner_delta, placeholder: "0.25", step: 0.001
    .field
      = f.label :next_inner_strike
      = f.number_field :next_inner_strike, placeholder: "20.0", step: 0.01
      .comment Literally the min (max) dollar amount of next strike
    .field
      %label next_threshold_usd_above_mark
      = f.number_field :next_threshold_usd_above_mark, placeholder: "80", step: 0.01

    .actions
      = f.submit


