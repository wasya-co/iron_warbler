
- u = 1 # = @purse.unit
- summary_unit = @purse.summary_unit
- collapse_key ||= nil

.purses--summary
  %i.fa.fa-expand.collapse-expand{ id: "pursesSummary_#{collapse_key}" } Summary
  .PurseSummaryW
    .PurseSummary

      .summary-amount
        .max-gl.long.loss{  style: "height: #{@max_loss_long *summary_unit*u}px" }
          %label Long Loss
          - if @loss_long
            .net-gl.loss.long.loss-long{   style: "height: #{@loss_long  *-1*summary_unit*u}px" }
          .delta
            .begin.long{  style: "height: #{@delta_long_begin/summary_unit*-1}px" }
            .end.long{    style: "height: #{@delta_long_end/summary_unit*-1}px" }

        .max-gl.short.loss{ style: "height: #{@max_loss_short *summary_unit*u}px" }
          %label Short Loss
          - if @loss_short
            .net-gl.loss.short.loss-short{ style: "height: #{@loss_short *-1*summary_unit*u}px" }
          .delta
            .begin.short{  style: "height: #{@delta_short_begin/summary_unit}px" }
            .end.short{    style: "height: #{@delta_short_end/summary_unit}px" }


      .summary-amount
        .max-gl.long.gain{  style: "height: #{@max_gain_long  *summary_unit*u}px" }
          %label Long Gain
        - if @gain_long
          .net-gl.gain.long.gain-long{   style: "height: #{@gain_long  *summary_unit*u}px" }

        .max-gl.short.gain{ style: "height: #{@max_gain_short *summary_unit*u}px" }
          %label Short Gain
          - if @gain_short
            .net-gl.gain.short.gain-short{ style: "height: #{@gain_short *summary_unit*u}px" }
      .c

      -# separated by long and short:
      .legendW
        .legend
          %label Short:
          %ul
            %li
              <b>exposure short:</b> -#{pp_amount @max_loss_short}
            %li.gray
              <b>max gain short:</b> #{pp_amount @max_gain_short}
            %li
              <b>loss short:</b> #{pp_amount @loss_short}
            %li
              <b>gain short:</b> #{pp_amount @gain_short}
            %li
              <b>Delta short begin:</b> #{pp_delta @delta_short_begin}
              <b>end:</b> #{pp_delta @delta_short_end}

          %label Long:
          %ul
            %li
              <b>exposure long:</b> -#{pp_amount @max_loss_long}
            %li.gray
              <b>max gain long:</b> #{pp_amount @max_gain_long}
            %li
              <b>loss long:</b> #{pp_amount @loss_long}
            %li
              <b>gain long:</b> #{pp_amount @gain_long}
            %li
              <b>Delta long begin:</b> #{pp_delta @delta_long_begin}
              <b>end:</b> #{pp_delta @delta_long_end}




    -# old, remove?
      .legendW
        .legend
          %ul
            %li
              <b>exposure long:</b> -#{pp_amount @max_loss_long}
              <b>short:</b> -#{pp_amount @max_loss_short}
            -# %li
            -#   <b>max loss long:</b> #{pp_amount [ @max_loss_long + @max_gain_short, 0].min }
            -#   <b>short:</b> #{pp_amount [ @max_loss_short + @max_gain_long, 0].min }
            %li.gray
              <b>max gain long:</b> #{pp_amount @max_gain_long}
              <b>short:</b> #{pp_amount @max_gain_short}

            %li
              %hr
              <b>gain long:</b> #{pp_amount @gain_long}
              <b>short:</b> #{pp_amount @gain_short}
            %li
              <b>loss long:</b> #{pp_amount @loss_long}
              <b>short:</b> #{pp_amount @loss_short}

            %li
              %hr
              <b>Delta long begin:</b> #{pp_delta @delta_long_begin}
              <b>end:</b> #{pp_delta @delta_long_end}
            %li
              <b>Delta short begin:</b> #{pp_delta @delta_short_begin}
              <b>end:</b> #{pp_delta @delta_short_end}

            %hr
            %li
              <b>Available amount:</b> #{pp_amount @purse.available_amount}


