
- u = @purse.unit

.purses--gameui

  .row.padded
    .col-md-6
      = render '/iro/purses/header', purse: @purse
    .col-md-6
      .summaries
        = render '/iro/purses/summary', purse: @purse, collapse_key: 'views-gameui-summary'
        = render '/iro/purses/summary2', purse: @purse, collapse_key: 'views-gameui-summary2'

  .purses-gameuiW{ data: { margin: { left: u*@n_dollars } } }
    .purses-gameui
      .purses-gameuiC{ style: "margin-left: #{u*@n_dollars}px; width: 100% " }

        - @positions.each_with_index do |pos, idx|
          - if idx == 0
            %h4.maxwidth= pos.stock
          - else
            - prev_ = @positions[idx-1]
            - if pos.stock != prev_.stock
              %hr
              %h4.maxwidth= pos.stock

          = render "/iro/positions/gameui_#{pos.strategy.kind}", position: pos
