
- purse ||= @purse
.purses--header

  .row.padded
    .col-md-6
      %h5.text-center
        Purse `#{purse.slug}`
        -# (#{purse.positions.length})
        &nbsp;
        = link_to '[sync]', sync_purse_path(purse)
        &nbsp;
        = link_to '[~]', edit_purse_path(purse)
        &nbsp;
        = link_to '[#]', purse_path(purse,  template: 'show', view_status: params[:view_status] )
        &nbsp;
        = link_to '[ui]', purse_path(purse, template: 'gameui', view_status: params[:view_status] )

      .row
        .col-12
          %ul
            -# %li <b>Balance:</b> #{pp_amount purse.balance}
            %li <b>Available:</b> #{pp_amount purse.available}

          .strategies--list
            %label strategies:
            %ul
              - purse.strategies.each do |st|
                %li
                  = link_to '[~]', iro.edit_strategy_path(st)
                  = render 'iro/strategies/show', strategy: st, collapse_key: st.id


      = render '/iro/positions/new', purse: purse

      .mini-inputs
        = form_for purse, html: { class: 'd-flex align-items-stretch' } do |f|
          = render '/iro/purses/form_extra_fields', f: f
          = f.submit '>'
        %br

      .d-flex
        %h5 view_status
        = form_tag purse_path( @purse ), method: :get do
          = select_tag :view_status, options_for_select([ :all, :active, :proposed, :pending ], selected: params[:view_status] )
          = hidden_field_tag :template, params[:template]
          = submit_tag '>'

    .col-md-6
      - if @max_loss_short || @max_loss_long
        .summaries
          -# = render '/iro/purses/summary', purse: @purse, collapse_key: 'views-gameui-summary'
          = render '/iro/purses/summary2', purse: @purse, collapse_key: 'views-gameui-summary2'
