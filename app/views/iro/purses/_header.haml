
- purse ||= @purse
.purses--header

  .row.padded
    .col-md-6
      %h5.text-center
        Purse `#{purse.slug}`
        -# (#{purse.positions.length})
        &nbsp;
        = link_to '[sync]', sync_purse_path(purse.id)
        &nbsp;
        = link_to '[~]', edit_purse_path(purse.id)
        &nbsp;
        = link_to '[=]', purse_path(purse.id,  vcfg: params[:vcfg].merge({ template: Iro::Purse::TEMPLATE_TABLE }))
        &nbsp;
        = link_to '[oo]', purse_path(purse.id, vcfg: params[:vcfg].merge({ template: Iro::Purse::TEMPLATE_GAMEUI }))

      = render '/iro/positions/new', purse: purse

      .a
        %i.fa.fa-expand.collapse-expand#strategies &nbsp;strategies
        %ul.strategies--list
          - purse.strategies.each do |st|
            %li
              = link_to '[~]', iro.edit_strategy_path(st)
              = render 'iro/strategies/show', strategy: st, collapse_key: st.id

      %i.fa.fa-expand.collapse-expand#units &nbsp;units
      .mini-inputs
        = form_for purse, html: { class: 'd-flex align-items-stretch' } do |f|
          = render '/iro/purses/form_extra_fields', f: f
          = f.submit '>'

      = render 'iro/positions/vcfg_form'

    .col-md-6
      - if @max_loss_short || @max_loss_long
        = render '/iro/purses/summary2', purse: @purse, collapse_key: 'views-gameui-summary2'
