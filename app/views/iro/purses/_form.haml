
.iro-purses--form
  = form_for purse do |f|
    .flex-row
      -# .field
      -#   %label stock
      -#   = f.select :stock_id, options_for_select( @stocks_list, selected: purse.stock_id )

      .field
        %label Slug
        = f.text_field :slug

      .field
        %label available amount
        = f.text_field :available_amount

      .field
        %label deleted_at
        = f.text_field :deleted_at

    = render '/iro/purses/form_extra_fields', f: f
    .actions
      = f.submit
