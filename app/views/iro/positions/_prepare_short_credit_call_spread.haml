
-##
-## _prepare_short_credit_call_spread
-## pos, prevpos
-##

- u              = pos.purse.unit # 50 ## pixels per dollar
- strategy       = pos.strategy
- nearest_strike = pos.stock.last.round
- stock          = pos.stock
- border_px = 2.00

.StockCoordinatesW.--prepare-short-credit-call-spread
  .StockCoordinates{ style: "height: #{@position.q * @position.purse.height}px " }
    .grid= render "/iro/stocks/grid", stock: stock, position: pos
    .Origin{ style: "left: #{ ( nearest_strike - pos.stock.last )* u}px" }
      .label Last: #{pos.stock.last }

      - amnt   = pos.next_gain_loss_amount
      - border = amnt >= 0 ? "#{amnt * u}px solid green" : "#{amnt * -1 * u}px solid red"
      - width  = "#{ ( pos.outer_strike - pos.inner_strike ) * u}px"
      - left   = "#{ ( pos.inner_strike - pos.stock.last ) * u}px"
      - long_or_short = pos.long_or_short == 'long' ? 'is-long' : 'is-short'
      .PositionW{ class: [ pos.strategy.kind, long_or_short ], style: "width: #{width}; left: #{left}; " }
        .Position
          .MaxGain{ style: "width: #{pos.max_gain * u}px" }
          .select= button_to 'select', prepare2_position_path({id: pos.id, prev_id: prevpos.id })

          - if amnt >= 0
            .Net.NetPositive{ style: "width: #{ amnt*u }px; left: -#{amnt*u + border_px}px" }
              .label net #{pp_amount amnt}
          - else
            .Net.NetNegative{ style: "width: #{ -amnt*u }px; left: 0" }
              .label net #{pp_amount amnt}
    .c