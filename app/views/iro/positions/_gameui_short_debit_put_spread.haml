
- pos   = position
- stock = pos.stock
- nearest_strike = stock.last.round
- u = pos.purse.unit # pixels per dollar


.d-flex{ id: "gameui-pos-#{pos.id}" }
  .maxwidth= render "/iro/positions/header", pos: pos
.--gameui-short-debit-put-spread
  = render "/iro/positions/header_#{pos.strategy.kind}", pos: pos
  .StockCoordinatesW
    .StockCoordinates{ style: "height: #{pos.q() *pos.purse.height}px " }
      .grid= render "/iro/stocks/grid_#{pos.strategy.long_or_short}", stock: stock, position: pos

      .Origin{ style: "left: #{ ( nearest_strike - stock.last )* u}px" }
        .origin-label Last: #{pp_amount stock.last}
        .c

        - left  = "#{ ( pos.outer.strike - stock.last ) *u}px"
        - width = ( pos.inner.strike - pos.outer.strike ).abs() *u
        - long_or_short = pos.long_or_short == 'long' ? 'is-long' : 'is-short'
        .PositionW{ class: [ pos.strategy.kind, long_or_short ], style: "left: #{left}; width: #{width}px; " }
          .Position
            - if pos.credit_or_debit == 'debit'
              .MaxGL.MaxLoss{ style: "width: #{pos.max_loss * u}px" }
            - else
              .MaxGL.MaxGain{ style: "width: #{pos.max_gain * u}px" }

            .RollGuide
            .Quantities
              - (pos.q-1).times do
                .item
            .net-label
              .labelC net #{pp_amount pos.net_amount}

            - if pos.net_amount >= 0
              - if stock.last < pos.inner.strike
                .Net.NetPositive{ style: "width: #{ pos.net_amount() *u}px; right: #{(pos.max_loss) *u}px;" }
              - else
                .Net.NetPositive{ style: "width: #{ pos.net_amount() *u}px; left: 100%;                  " }
            - else
              - if stock.last < pos.breakeven
                .Net.NetNegative{ style: "width: #{ -1 * pos.net_amount*u }px; right: #{pos.max_gain*u}px; " }
              - else
                .Net.NetNegative{ style: "width: #{ -1 * pos.net_amount*u }px; right: 0;                   " }

            .SingleDelta
              .end{ style: "width: #{100.0 * pos.end_delta / pos.begin_delta}%; background: #{pos.end_delta.abs > pos.begin_delta.abs ? 'rgba(255,0,0, 0.2)' : 'rgba(0,0,0, 0.2)' }" }

.c

