
- u              = pos.purse.unit # 50 ## pixels per dollar
- strategy       = pos.strategy
- nearest_strike = pos.stock.last.round
- stock          = pos.stock
- border_px = 2.00
- long_or_short = pos.long_or_short == 'long' ? 'is-long' : 'is-short'

.StockCoordinatesW.--prepare-diag-long-call-spread
  .StockCoordinates{ style: "height: #{@position.q * @position.purse.height}px " }
    .grid= render "/iro/stocks/grid_#{pos.strategy.long_or_short}", stock: stock, position: pos
    .Origin{ style: "left: #{ ( nearest_strike - pos.stock.last )* u}px" }
      -# .label Last: #{pp_amount pos.stock.last }

      - amnt   = pos.next_gain_loss_amount
      - width  = "#{ ( pos.inner.strike - pos.outer.strike ) * u}px"
      - left   = "#{ ( pos.outer.strike - pos.stock.last ) * u}px"

      .PositionW{ class: [ pos.strategy.kind, long_or_short ], style: "width: #{width}; left: #{left}; " }
        .Position
          .MaxGL.MaxGain{ style: "width: #{pos.max_gain * u}px" }
          .select= button_to 'select', prepare2_position_path({id: pos.id, prev_id: prevpos.id })

          - if amnt >= 0
            .Net.NetPositive{ style: "width: #{ amnt*u }px; right: -#{amnt*u + border_px}px" }
              .label
                .labelC net #{pp_amount amnt}
          - else
            .Net.NetNegative{ style: "width: #{ -amnt*u }px; right: 0" }
              .label
                .labelC net #{pp_amount amnt}
    .c