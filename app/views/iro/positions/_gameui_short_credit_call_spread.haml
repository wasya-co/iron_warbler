
- pos   = position
- stock = pos.stock
- nearest_strike = stock.last.round
- u = pos.purse.unit # pixels per dollar
- border_px = 2.0

-#
-# 2026-02-19 copy-pasted from long put spread, _TODO: change everything.
-#

.collapse-expand.d-flex.--gameui-short-credit-call-spread{ id: "gameui-pos-#{pos.id}" }
  [<>]
  .maxwidth= render "/iro/positions/header", pos: pos
.a
  = render "/iro/positions/header_#{pos.strategy.kind}", pos: pos
  .StockCoordinatesW
    .StockCoordinates{ style: "height: #{pos.q() *pos.purse.height}px " }
      .grid= render "/iro/stocks/grid", stock: stock, position: pos

      .Origin{ style: "left: #{ ( nearest_strike - stock.last )* u}px" }
        .label Last: #{pp_amount stock.last}
        .c

        - left  = "#{ ( pos.inner.strike - stock.last ).abs() *u}px"
        - width = "#{ ( pos.inner.strike - pos.outer.strike ).abs() *u}px"
        - long_or_short = pos.long_or_short == 'long' ? 'is-long' : 'is-short'
        .PositionW{ class: [ pos.strategy.kind, long_or_short ], style: "left: #{left}; width: #{width}; " }
          .Position
            .MaxGain{ style: "width: #{pos.max_gain * u}px" }
            .RollGuide

            - if pos.net_amount >= 0
              - if 'is-long' == long_or_short
                .Net.NetPositive{ style: "width: #{ pos.net_amount*u }px; right: 0" }
                  .label net #{pp_amount pos.net_amount}
              - else
                .Net.NetPositive{ style: "width: #{ pos.net_amount*u }px; left: -#{pos.net_amount*u + border_px}px" }
                  .label net #{pp_amount pos.net_amount}

            - else
              .Net.NetNegative{ style: "width: #{ (-1 * pos.net_amount) * u }px; left: 100%" }
                .label
                  net
                  = pp_amount pos.net_amount
.c

