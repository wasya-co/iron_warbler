
- pos   = position
- stock = pos.stock
- nearest_strike = stock.last.round
- u = pos.purse.unit # pixels per dollar
- border_px = 2.0

-##
-## 2026-02-19 copy-pasted from long put spread
-## 2026-04-05 move loss inside, gain outside
-##

.d-flex.--gameui-short-credit-call-spread{ id: "gameui-pos-#{pos.id}" }
  .maxwidth= render "/iro/positions/header", pos: pos
.--gameui-short-credit-call-spread
  = render "/iro/positions/header_#{pos.strategy.kind}", pos: pos
  .StockCoordinatesW
    .StockCoordinates{ style: "height: #{pos.q() *pos.purse.height}px " }
      .grid= render "/iro/stocks/grid", stock: stock, position: pos

      .Origin{ style: "left: #{ ( nearest_strike - stock.last )* u}px" }
        .origin-label Last: #{pp_amount stock.last}
        .c

        - left  = "#{ ( pos.inner.strike - stock.last ) *u}px"
        - width = "#{ ( pos.inner.strike - pos.outer.strike ).abs() *u}px"
        - long_or_short = pos.long_or_short == 'long' ? 'is-long' : 'is-short'
        .PositionW{ class: [ pos.strategy.kind, long_or_short ], style: "left: #{left}; width: #{width}; " }
          .Position
            .MaxGain{ style: "width: #{pos.max_gain * u}px" }
            .RollGuide
            .Quantities
              - (pos.q-1).times do
                .item
            .net-label
              .labelC net #{pp_amount pos.net_amount}

            - if pos.net_amount >= 0
              .Net.NetPositive{ style: "width: #{ pos.net_amount*u }px; left: #{-1* pos.net_amount() *u + border_px}px" }
            - else
              - if stock.last > pos.breakeven
                .Net.NetNegative{ style: "left: #{pos.max_gain*u}px; width: #{ -1 * pos.net_amount*u }px;" }
              - else
                .Net.NetNegative{ style: "left: 0; width: #{ -1 * pos.net_amount*u }px;" }

.c

