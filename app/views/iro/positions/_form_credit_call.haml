
.positions--form-credit-call
  = form_for position do |f|
    .actions
      = f.submit

    .d-flex
      .field
        %label Purse
        = f.select :purse_id, options_for_select( @purses_list, selected: position.purse_id )
      .field
        %label Status
        = f.select :status, options_for_select( Iro::Position::STATUSES, selected: position.status )

    .d-flex
      .field
        %label Stock
        = f.select :stock_id, options_for_select( @stocks_list, selected: position.stock_id )
      .field
        %label put_call
        = f.select :put_call, options_for_select([nil, 'PUT', 'CALL'], selected: position.put_call)
        = position.put_call

    .field
      %label Strategy
      = f.select :strategy_id, options_for_select( @strategies_list, selected: position.strategy_id )

    .d-flex
      .field
        %label Expires on
        = f.select :expires_on, options_for_select( Iro::Option.expirations_list, selected: position.expires_on.to_date )
        -# = position.expires_on
      .field
        %label Quantity
        = f.text_field :quantity

    .field
      %label Begin on
      = f.text_field :begin_on, value: position.begin_on || Time.now.to_date.to_s

    .d-flex
      = fields_for :inner, position.inner do |f_inner|
        .field
          %label Inner Strike
          = f_inner.number_field :strike, step: 0.01
        .field
          %label Begin inner price
          = f_inner.text_field :begin_price
        .field
          %label Begin inner delta
          = f_inner.text_field :begin_delta

    .actions
      = f.submit
