
- collapse_key ||= pos.id
- q = pos.quantity

%i.fa.fa-expand.collapse-expand.floaty-collapse{ id: "gameui-pos-detail-#{collapse_key}" }
.maxwidth.--header-long-credit-put-spread
  %ul.m-0.p-0
    %li
      <b>begin $:</b> (#{pp_amount pos.outer.begin_price} <- #{pp_amount pos.inner.begin_price})
      <b>net_ea/max_gain:</b> #{pp_amount pos.net_amount * 100}/#{pp_amount pos.max_gain * 100} :: #{pp_percent pos.net_percent}

    %li
      <b>end $:</b> (#{pp_amount pos.outer.end_price} <- #{pp_amount pos.inner.end_price})
      <b>breakeven:</b> #{pp_amount pos.breakeven}
      <b>max_loss:</b> #{pp_amount pos.max_loss * 100*q}

