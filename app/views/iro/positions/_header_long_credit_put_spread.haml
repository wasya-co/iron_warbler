
- collapse_key ||= pos.id
- q = pos.quantity

%i.fa.fa-expand.collapse-expand.floaty-collapse{ id: "gameui-pos-detail-#{collapse_key}" }
.maxwidth.positions--header.--header-long-credit-put-spread
  %table.bordered.no-padding
    %tr
      %td
        <b>end $:</b>
      %td.text-center.pl-1.pr-1
        [#{pp_amount pos.outer.end_price} << #{pp_amount pos.inner.end_price}]
      %td
        <b>max_gain * q:</b>
      %td.text-center.pl-1.pr-1
        #{pp_amount pos.max_gain * 100} *= #{pp_amount pos.max_gain * 100*q}
      %td
        &nbsp;
      %td
        <b>D:</b>
      %td.text-center.pl-1.pr-1
        [[ #{pos.outer.end_delta} << #{pos.inner.end_delta} ]]
    %tr
      %td
        <b>begin $:</b>
      %td.text-center.pl-1.pr-1
        [#{pp_amount pos.outer.begin_price} << #{pp_amount pos.inner.begin_price}]
      %td.text-center.pl-1.pr-1
        <b>net_ea * q:</b>
      %td.text-center.pl-1.pr-1
        #{pp_amount pos.net_amount * 100} *= #{pp_amount pos.net_amount * 100*q}
      %td.text-center.pl-1.pr-1
        <i>#{pp_percent pos.net_percent}</i>
      %td
        <b>D:</b>
      %td.text-center.pl-1.pr-1
        [[ #{pos.outer.begin_delta} << #{pos.inner.begin_delta} ]]


