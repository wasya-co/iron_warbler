
.positions--vcfg-form.bordered

  = form_tag nil, method: :get do

    .poss-selector.d-flex
      %label statuses:
      - Iro::Position::STATUSES.compact.each do |st|
        .item.bordered
          %label
            = check_box_tag 'vcfg[statuses][]', st, params[:vcfg][:statuses]&.include?(st)
            = st
    .poss-selector.d-flex
      %label template:

      %label
        = radio_button_tag 'vcfg[template]', Iro::Purse::TEMPLATE_TABLE, params[:vcfg][:template] == Iro::Purse::TEMPLATE_TABLE
        = Iro::Purse::TEMPLATE_TABLE

      %label
        = radio_button_tag 'vcfg[template]', Iro::Purse::TEMPLATE_GAMEUI, params[:vcfg][:template] == Iro::Purse::TEMPLATE_GAMEUI
        = Iro::Purse::TEMPLATE_GAMEUI

    = submit_tag '>'