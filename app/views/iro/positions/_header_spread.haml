
- collapse_key ||= pos.id
%i.fa.fa-expand.collapse-expand.floaty-collapse{ id: "gameui-pos-detail-#{collapse_key}" }
.maxwidth
  %ul.m-0.p-0
    - if !pos.persisted? ## NOT persisted
      %li <b>expires_on:</b> #{pos.expires_on}
      %li <b>inner_strike:</b> #{pp_amount pos.inner_strike}
      %li <b>next_gain_loss_amount:</b> #{pp_amount pos.next_gain_loss_amount}

    %li
      <b>begin_outer_price:</b> #{pp_amount pos.outer.begin_price} <b>begin_inner_price:</b> #{pp_amount pos.inner.begin_price}
      <b>max_gain:</b> #{pp_amount pos.max_gain * 100} <b>max_loss:</b> #{pp_amount pos.max_loss * 100}
    %li
      <b>end_outer_price:</b>   #{pp_amount pos.outer.end_price}   <b>end_inner_price:</b>   #{pp_amount pos.inner.end_price}
      <b>Net:</b> #{pp_amount pos.net_amount * 100} &nbsp; <i>#{pp_percent pos.net_percent}</i>
    %li <b>kind:</b> #{pos.strategy.kind}
