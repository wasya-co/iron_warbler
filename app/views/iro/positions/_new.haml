
.d-flex
  .Card
    -# %h5.text-center New position
    = form_for Iro::Position.new(strategy: Iro::Strategy.new), url: new_position_path, method: :get do |f|
      = hidden_field_tag 'position[purse_id]', purse.id

      .formrow-v1
        .label <b>New Position</b>

        .d-flex.flex-column
          -# %label Stock
          -# = f.select :stock_id, options_for_select(@stocks_list)

        .d-flex.flex-column
          %label Strategy
          = f.select :strategy_id, options_for_select([[nil,nil]] + purse.strategies.map { |s| [ s.to_s, s.id ] })

        .d-flex.flex-column
          %label Expires on
          = f.select :expires_on, options_for_select( Iro::Option.expirations_list )

        .d-flex.flex-column
          %label Q
          = f.text_field :quantity, class: 'w-3em'

        = f.submit '>'

