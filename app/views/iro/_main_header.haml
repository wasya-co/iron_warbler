
.application--main-header.main-header.iro--main-header{ class: "#{ENV['RAILS_ENV']} #{ENV['RAILS_ENV'][0...3]=="dev" ? "development" : ''}" }
  .maxwidth

    %i.fa.fa-compress.collapse-expand#collapseHeaderTrading
      Wco Trading
    .W
      .d-flex.flex-wrap
        %ul
          %li
            = link_to "Schwab Login", "https://api.schwabapi.com/v1/oauth/authorize?client_id=#{SCHWAB_DATA[:key]}&redirect_uri=#{SCHWAB_DATA[:redirect_url]}"
            = link_to '[sync]', schwab_sync_path
          %li
            = link_to "Exec Login", "https://api.schwabapi.com/v1/oauth/authorize?client_id=#{SCHWAB_EXEC[:key]}&redirect_uri=#{SCHWAB_EXEC[:redirect_url]}"
            = link_to '[sync]', schwab_sync_exec_path
          %li
            = link_to "Stocks (#{Iro::Stock.all.length})", stocks_path
            = link_to '[sync]', sync_stocks_path
          %li
            = link_to "Alerts (#{Iro::Alert.all.length})", alerts_path
          -# %li
          -#   = link_to "Purses (#{Iro::Purse.all.length})", purses_path
          %li
            = render '/iro/strategies/header'


        .ml-3
          = link_to "Purses (#{Iro::Purse.all.length})", purses_path
          = link_to '[+]', purses_path
          %ul
            - @purses.each do |p|
              %li
                = p
                &nbsp;
                = link_to '[#]', purse_path(p)
                &nbsp;
                = link_to '[ui]', purse_gameui_path(p)

        -#
          = link_to 'Strategies', strategies_path
          %ul
            - @strategies.each do |s|
              %li
                = link_to s, strategy_path(s)
                = link_to '[~]', edit_strategy_path(s)
        .a
          %ul
            %li
              Datapoints
              = form_tag datapoints_by_symbol_path, method: :get do
                = text_field_tag :q


