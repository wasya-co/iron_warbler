
.stocks-show.padded
  .header
    %h5.text-center
      .d-inline-block= select_tag :stock_selector, options_for_select( @stocks_list, selected: @stock.ticker ), class: 'select2'
      = link_to '[~]', edit_stock_path(@stock)

  .collapse-expand#Actions [&lt;>] Actions
  .row
    .col-6
      %ul.actions
        %li Current Price: #{@stock.last}
        %li
          = form_tag stock_get_historic_data_path(@stock) do
            get historic data from:
            = text_field_tag :date_from, nil, placeholder: 'yyyy-mm-dd'
            = submit_tag 'Go'
        %li
          = form_tag viz_1_path(@stock), method: :get do
            - nxt = Date.current.next_occurring(:friday).to_date
            - nxt = Time.previous_business_day(nxt) if !nxt.workday?
            = text_field_tag :expires_on, nxt, placeholder: 'yyyy-mm-dd'
            = submit_tag 'expiry-viz'
    .col-6
      = button_to 'recompute', stock_recompute_volatility_path(@stock)
      %ul
        %li
          %b 1 yr volatility <br />
          = @stock.volatility_annual
        %li
          %b monthly <br />
          = @stock.volatility_monthly
        %li
          %b daily <br />
          = @stock.volatility_daily
  .c

  .collapse-expand#datapoints_0 [&lt;>] Review Datapoints
  .row
    .col-md-6
      - date_oldest = @datapoints.last.date
      - today = Date.today
      - current = date_oldest
      - while current <= today
        = @datapoints_h[current.to_s] ? '^' : '.'
        - if current.next_day.month != current.month || current == today
          %br
        - current = current.next_day
    .col-md-6
      .d-flex
        - start_date = @datapoints.last.date
        - today = Date.today
        - (start_date..today).group_by { |d| d.beginning_of_month }.each do |month, days|
          %div.bordered
            %h5= month.strftime("%B %Y")
            %ol.no-dot
              - days.each do |_day|
                %li
                  - if @datapoints_h[_day.to_s]
                    \^
                  - elsif _day.saturday? || _day.sunday?
                    S
                  - else
                    - if _day.workday?
                      .red .
                    - else
                      h
  .c

  .collapse-expand#stockChart_0 [&lt;>] Line Charts
  .a
    .d-flex
      .a
        .text-center 1yr
        #Stock_1yr{ data: { props: @datapoints_1yr.to_json } }
      .a
        .text-center 6mo
        #Stock_6mo{ data: { props: @datapoints_6mo.to_json } }
      .a
        .text-center 3mo
        #Stock_3mo{ data: { props: @datapoints_3mo.to_json } }
      .a
        .text-center 1mo
        #Stock_1mo{ data: { props: @datapoints_1mo.to_json } }
  .c

  .collapse-expand#stockHistogram_0 [&lt;>] Histograms
  .a
    .d-flex
      .a
        .text-center 1yr
        #StockHist_1yr{ data: { props: @histogram_1yr.to_json } }
      .a
        .text-center 6mo
        #StockHist_6mo{ data: { props: @histogram_6mo.to_json } }
      .a
        .text-center 3mo
        #StockHist_3mo{ data: { props: @histogram_3mo.to_json } }
      .a
        .text-center 1mo
        #StockHist_1mo{ data: { props: @histogram_1mo.to_json } }
  .c
