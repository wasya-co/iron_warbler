
.stocks-show.maxwidth
  .header
    %h3.title
      = select_tag :stock_selector, options_for_select( @stocks_list, selected: @stock.ticker ), class: 'select2'

  .row
    .col-md-3
      %h4 Datapoints
      %table.bordered
        %thead
          %td Date
          %td Value
        %tbody
          - @datapoints.each do |pt|
            %tr
              %td= pt.date
              %td= pt.value


    .col-md-9
      %ul
        %li
          %b 1 yr volatility <br />
          = @stock.volatility

      %h4 Max Pain
      %pre
        = JSON.pretty_generate @max_pain_summary