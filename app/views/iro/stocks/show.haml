
.stocks-show.maxwidth
  .header
    %h3.title
      = select_tag :stock_selector, options_for_select( @stocks_list, selected: @stock.ticker ), class: 'select2'

  = form_tag stock_get_historic_data_path(@stock) do
    get historic data:
    = text_field_tag :date_from
    = submit_tag 'Go'

  .row

    .col-md-6
      %hr
      = button_to 'recompute', stock_recompute_volatility_path(@stock)
      %ul
        %li
          %b 1 yr volatility <br />
          = @stock.volatility_annual

        %li
          %b monthly <br />
          = @stock.volatility_monthly
        %li
          %b daily <br />
          = @stock.volatility_daily


    -# .col-md-6
    -#   %h4 Strategies [+]
    -#   %ul
    -#     - @stock.strategies.each do |st|
    -#       %li= link_to st, strategy_path(st)

  .row
    -#
      .col-md-6
        %h4 Datapoints
        %table.bordered
          %thead
            %td Date
            %td Value
          %tbody
            - @datapoints.each do |pt|
              %tr
                %td= pt.date
                %td= pt.value

    .col-md-6
      %h4 Datapoints
      - date_oldest = @datapoints.last.date
      - today = Date.today
      - current = date_oldest
      - while current <= today
        = @datapoints_h[current.to_s] ? '^' : '.'
        - if current.next_day.month != current.month || current == today
          %br
        - current = current.next_day

      %h4 Datapoints
      .d-flex
        - start_date = @datapoints.last.date
        - today = Date.today
        - (start_date..today).group_by { |d| d.beginning_of_month }.each do |month, days|
          %div.bordered
            %h5= month.strftime("%B %Y")
            %ol.no-dot
              - days.each do |_day|
                %li
                  - if @datapoints_h[_day.to_s]
                    \^
                  - elsif _day.saturday? || _day.sunday?
                    S
                  - else
                    - if _day.workday?
                      .red .
                    - else
                      h

