
- nearest_strike = stock.last.round
- u       = @purse.unit
- every_n = @purse.mark_every_n_usd

.grid-mark.mark0
  .label
    .labelC= nearest_strike
- (1...@n_dollars).each_with_index do |idx|
  - idx = idx * every_n
  .grid-mark{ class: "mark#{idx}", style: "left: #{idx * u}px" }
    .label
      .labelC= nearest_strike + idx
  .grid-mark{ class: "mark-#{idx}", style: "left: -#{idx * u}px" }
    .label
      .labelC= nearest_strike - idx