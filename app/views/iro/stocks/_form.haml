
.iro-stocks--form
  = form_for stock do |f|
    .flex-row

      .field
        - if stock.new_record?
          %label New
        - else
          = f.select :status, options_for_select([ Iro::Stock::STATUS_ACTIVE, Iro::Stock::STATUS_INACTIVE ], selected: stock.status)
      .field
        = f.label :ticker
        = f.text_field :ticker

      .field
        %label Last
        = f.number_field :last, placeholder: '80.0', step: 0.01

      .field
        %label options price increment
        = f.number_field :options_price_increment, step: 0.5

      .actions
        = f.submit
