
.iro-stocks--form
  = form_for stock do |f|
    .actions
      = f.submit

    .flex-row

      .field
        - if stock.new_record?
          %label New
        - else
          %label status
          = f.select :status, options_for_select([ Iro::Stock::STATUS_ACTIVE, Iro::Stock::STATUS_INACTIVE ], selected: stock.status)
      .field
        = f.label :ticker
        = f.text_field :ticker

      -# .field
      -#   %label Last
      -#   = f.number_field :last, placeholder: '80.0', step: 0.01

      .field
        %label options price increment
        = f.number_field :options_price_increment, step: 0.5

    .flex-row
      .field
        %label min
        = f.number_field :min, step: 0.5
      .field
        %label max
        = f.number_field :max, step: 0.5
      .field
        %label step
        = f.number_field :step, step: 0.5, default: 1

    .row
      .field
        %label descr
        = f.text_area :descr

    .actions
      = f.submit
