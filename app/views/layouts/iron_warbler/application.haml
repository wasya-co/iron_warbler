!!!
%html
  %head
    %meta{content: "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}
    %title Iron Warbler
    = csrf_meta_tags
    = stylesheet_link_tag    'iron_warbler/application', media: 'all'
    = javascript_include_tag 'iron_warbler/application'
    %meta{content: "width=device-width, initial-scale=1.0", name: "viewport"}
    %meta{charset: "UTF-8"}
    %meta{description: "Iron Warbler"}
    %meta{content: "Iron Warbler", property: "og:type"}
    %meta{content: "Iron Warbler", property: "og:title"}
    %meta{content: "Iron Warbler", property: "og:description"}

  %body

    %ul
      %li= link_to 'Back to Manager', '/manager'
      %li= link_to 'Option Watches', option_watches_path

    %p.notice= flash[:notice]
    %p.alert= flash[:alert]

    = yield
